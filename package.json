    "@payloadcms/db-sqlite": "3.94.0",
    "@payloadcms/email-nodemailer": "3.94.0",
    "@payloadcms/next": "3.94.0",
    "@payloadcms/richtext-lexical": "3.94.0",
    "@payloadcms/storage-vercel-blob": "3.94.0",
    "@payloadcms/translations": "3.94.0",
    "graphql": "^16.8.1",
    "leaflet": "^1.9.4",
    "next": "16.4.6",
    "payload": "3.94.0",
    "react": "^19.0.0",
