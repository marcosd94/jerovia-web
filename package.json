  "private": true,
  "type": "module",
  "description": "Sitio web + tienda + panel de administración (plantilla white-label). Marca activa: ver brand/active.ts",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
