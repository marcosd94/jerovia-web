# Copiá este archivo como .env y completá los valores. NUNCA subas .env a Git.

# Clave larga y aleatoria (mínimo 32 caracteres). Generala con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=cambiar-por-una-clave-larga-y-aleatoria

# Dirección pública del sitio (sin barra final)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=es

# Google Analytics 4 (opcional). Dejar vacío = sin medición. Formato: G-XXXXXXXXXX
# Solo se activa cuando la persona acepta las cookies de medición.
NEXT_PUBLIC_GA_ID=

# Base de datos.
#  - Desarrollo: SQLite (archivo local, no requiere instalar nada)
#  - Producción: PostgreSQL, por ejemplo postgres://usuario:clave@host:5432/jerovia
DATABASE_URL=file:./data/dev.db

# Solo para `npm run seed` (crea el primer usuario administrador)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# true = también crea un usuario de ejemplo por cada rol (solo en desarrollo)
SEED_DEMO_USERS=false

# Correo (opcional en desarrollo). Con SMTP_HOST: se exige verificar el correo de las cuentas de clientes
# y se envían los correos de "olvidé mi contraseña". Sin SMTP_HOST: las cuentas quedan activas al crearse.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=
